# Starting job
def run_job():
    # For HF reference calculation as I understand. Should be probably a bit tighter for finite field (possibly its even faster do to better guess?)
    e_convergence_val=1e-10
    set_options(dict(
        e_convergence=e_convergence_val, 
    ))
    storage['settings']['e_convergence']= e_convergence_val
    # External FIELD PARAMETERS
    center_of_charge = get_center_of_charge(the_molecule) # For evaluation of multipoles and setup of external field
    distance=1000.0 # Large distance to approximate uniform field
    delta_dip=1.000000E-03
    delta_qad=1.000000E-04
    storage['settings']['ff_val_dip']= delta_dip
    storage['settings']['ff_val_qad']= delta_qad
    
    # Field moments to apply finited field
    tensor_elements=[
        'x',
        'y',
        'z',
        'xx',
        'yy',
        'zz',
        'xy',
        'yz',
        'xz',
    ]
    
    psi4.set_global_option('PROPERTIES_ORIGIN', np.array(center_of_charge).tolist() )
    # vec=[ -float(x) for x in center_of_charge ]
    # the_molecule.translate(core.Vector3(vec[0],vec[1],vec[2]))
    
    # Generate external potentials (unit value will be tuned by FF value)
    pot_reg=dict() # Save all external potentials there (base version)
    for tensor_key in tensor_elements:
        pot_base = make_external_field(tensor_key, center_of_charge, d=distance)
        pot_reg.update({ tensor_key:pot_base })
    pot_reg.update( zero=None ) # zero potenial
    
    # Evaluate wfn in external potential
    
    ff_reg=dict()
    E,wfn,grad,mom= get_moments( pot_reg['zero'], 0, do_mom=True ) # Should be True if we want zero point moments
    ff_reg.update( zero=dict({ 'delta':0, 'E':E, 'mom': mom }))
    
    # Save the wave function
    fchk_file='POLARIZ_FF_hf_cc-pvdz_Molecular_Polarizability_2_wid-46636b61-a395-4832-a689-14187bf07d44.fchk'
    fchk(wfn, fchk_file)
    
    storage['files'].update({ 'final_fchk':fchk_file})
    storage['results']['energetic'].update({ 'energy': E, 'gradient': (grad.to_array().tolist() if grad is not None else None) })
    for i,t in enumerate(tensor_elements):
        delta= (delta_dip if len(t)==1 else delta_qad)
        for x in [ -1 , 1 ]: # negative and positive field
            do_mom=True if x>0 else False  # only do moments for positive field (negative is for energy derviation) 
            E,wfn,grad,mom= get_moments( pot_reg[t] , x*delta, 
                do_mom=do_mom ) # only do moments for positive field (negative is for energy derviation) 
            ff_reg.update({ t+('_neg' if x==-1 else '_pos'):dict({ 'delta': x*delta, 'E': E, 'mom': mom } )})
        print_out(f"CUSTOM MARKER BY USER: Finished moment '{t}' ({i} out of {len(tensor_elements)}, {i+1/len(tensor_elements)*100}%)")
    
    # get polarisabilities through finite differences
    pol_reg=dict()
    pol_through_energy=dict()
    for t in tensor_elements:
        first,second, third= ff_reg[t+'_pos'], ff_reg['zero'], ff_reg[t+'_neg']
        print_out(f"E={first['E']} , E0={second['E']} for tag={t} and delta={delta}\n")
        cur_pol=dict()
        delta = (first['delta'] - second['delta'] )
        mapper=dict( (k,i) for i,k in enumerate(['x','y','z']) )
        pol_through_energy[f"{t}@{t}"]=float(-(first['E']-2*second['E']+third['E'])/(delta**2) \ # FD formula (polarisabilities are positive by convention)
            *( 1/2 if len(t)==2 else 1) ) # Induction Energy
        if any(x['mom'] is None for x in [first, second] ): continue
        for k in set(list(first['mom'].keys())+list(second['mom'].keys()) ):
            assert k in first['mom'].keys() and k in second['mom'].keys()
            ff_mom=( first['mom'][k] - second['mom'][k]) / delta
            cur_pol.update({ k:  np.array(ff_mom).tolist() })
        pol_reg.update({ t : cur_pol })
    
    # Gather and reform polarisabilities
    for t in tensor_elements:
        pol = pol_reg[t]
        for k in sorted(pol.keys()):
            m=pol[k]
            np.set_printoptions(precision=3, suppress=True)
            the_string=np.array2string(np.array(m),separator = ' ')
            print_out( f"\n{k}@{t}: pol is \n{the_string}\n" )
    pol_vals=pol_transform(pol_reg)
    # Get Multipoles from zero field calculation
    moms={}
    for k,v in ff_reg['zero']['mom'].items():
        moms.update(tag_matrix(v))
    #Store object
    storage['results']['properties']['expansion_center']= [ float(x) for x in center_of_charge]
    storage['results']['properties']['MolPol_FinFie_through_dens']= pol_vals
    storage['results']['properties']['MolPol_FinFie_through_eng']= pol_through_energy
    storage['results']['properties']['MolMom']= moms

# Execute the job
try:
    start_polariz_ff=time.time()
    run_job()
    storage['about_the_run']['timings']['Total Time for POLARIZ_FF']= start_polariz_ff-time.time()
finally: clean() # I allways want to clean up the scratch

