### Imports
import time
import yaml
run_started_at=time.time()

# Store variables here (eg IP)
from collections import defaultdict # allows for creating key paths beyond one level: dic=defaultdict(dict); dic['a']['b']=c
def nested_dict(): return defaultdict(nested_dict) # Required for arbitrary depth
storage=defaultdict(nested_dict)
storage_file='STORAGE_POLARIZ_FF_hf_cc-pvdz_Molecular_Polarizability_2_wid-46636b61-a395-4832-a689-14187bf07d44.yaml' # will drop here at the end of the run
def dump_storage():
    # Time the complete run
    storage['about_the_run']['timings'].update(
        total_run_time= time.time()-run_started_at
    )
    # Drop the storage aclean_rec()s yaml file
    def clean_rec(dic):
        if isinstance(dic, (defaultdict,dict)):
            dic = {k: clean_rec(v) for k,v in dic.items()}
        return dic
    def drop_yaml(storage, storage_file):
        with open(storage_file, 'w') as wr:
            yaml.dump(clean_rec(storage),wr)
        print(f"Dropped stored variables under {storage_file}")
    drop_yaml( dict(storage), storage_file)

# Hardware settings 
hardware_settings=dict(
    memory='4.0 GB',
    num_threads=1,
)
set_memory(hardware_settings['memory'])
set_num_threads(hardware_settings['num_threads'])
storage['about_the_run'].update(hardware_settings)

#Define the molecule (definition in molecule string has the advantage of being able to create new molecules reliable)
monomer_string="""
    # Number of nuclei: 2
    0 1 # Charge and Multiplicity
    H       0.00000000      0.00000000     -0.37000000
    H       0.00000000      0.00000000      0.37000000
    symmetry c1
    nocom
    noreorient
    units ANGSTROM
"""
the_molecule=Molecule.from_string(monomer_string)

#### FUNCTIONS (could be moved to other file but this way its implicity portable [no need to copy multiple files])
def eval_moments(wfn):
    oeprop = psi4.core.OEProp(wfn)
    oeprop.add('MULTIPOLE(1)')
    oeprop.add('MULTIPOLE(2)')
    oeprop.add('MULTIPOLE(3)')
    oeprop.add('MULTIPOLE(4)')
    oeprop.compute()
    return dict({ 
        'DIPOLE' : wfn.variable('DIPOLE'),
        'QUADRUPOLE' : wfn.variable('QUADRUPOLE'),
        'OCTUPOLE' : wfn.variable('OCTUPOLE'),
        'HEXADECAPOLE' : wfn.variable('HEXADECAPOLE'),
    })

def get_moments(ext_pot, delta, do_mom=True):
    ext_pot=( [ (q*delta,v) for q,v in ext_pot['charges'] ]
        if not ( ext_pot is None or ext_pot==[]) else None)
    single_point_time=time.time()
    E, wfn = energy( method , external_potentials=ext_pot , return_wfn=True , molecule=the_molecule )
    try:
        storage['about_the_run']['timings']['single_point'] = storage['about_the_run']['timings'].get('single_point', 0) + (time.time()-single_point_time)
    except Exception as ex:
        print_out(f"WARNING: could not save timing for 'single_point': {ex}")
    grad=None 
    
    if do_mom:
        start_mom=time.time()
        mom= eval_moments(wfn)
        try:
            storage['about_the_run']['timings']['eval_mom'] = storage['about_the_run']['timings'].get('eval_mom', 0) + (time.time()-start_mom)
        except Exception as ex:
            print_out(f"WARNING: could not save timing for 'eval_mom': {ex}")
    else: mom=None
    return E,wfn,grad,mom

def tensor_tag_from_indices(indices):
    """Return the tensor tag string for a given index combination (e.g. [0,1,2] -> 'xyz')."""
    mapper = ["x", "y", "z"]
    return ''.join(mapper[i] for i in indices)

def tag_matrix(M, field=None):
    def get_val(ind):
        return float(M[tuple(ind)])
    new_M={}
    M = np.asarray(M)
    base_tag=f"@{field}" if not field is None else ''

    dims=M.shape
    # get all indices of M
    all_indices = list(np.ndindex(M.shape))
    for ind in all_indices:
        tag=tensor_tag_from_indices(ind)
        new_M.update({tag+base_tag: get_val(ind)})

    return new_M

def pol_transform(pols):
    new_pols={}
    for t,pol in pols.items():
        for k,v in pol.items():
            new_tags=tag_matrix(v, t)
            if new_tags is None: continue
            for kk,vv in new_tags.items():
                if kk in new_pols.keys(): raise Exception(f"Already defined: \'{k}\'")
                else: new_pols.update({kk:vv})
    return new_pols

def make_external_field(key, center, d):
    """ key: str (e.g. 'x', 'xx' or 'xy' )
    center: np.ndarray center of fields
    d: float separation parameter (how far are the charges from center)
    """

    def get_dir(key):
        mapper={
            'x': np.array([1.,0.,0.]),
            'y': np.array([0.,1.,0.]),
            'z': np.array([0.,0.,1.]),
        }
        return mapper[key]
    
    if len(key)==1:
        vec=get_dir(key)
        arrangement=[
            ( -1, -vec),
            ( 1, vec),
        ]
        q= -d**2/2.
    elif len(key)==2:
        a,b=key[0],key[1]
        vec1, vec2=get_dir(a), get_dir(b)
        q= -d**3/3.
        if a==b:
            arrangement=[
                ( 2., -vec1),
                ( 2., vec1),
            ]
        else:
            arrangement=[
                ( +1, + (vec1 + vec2)),
                ( +1, - (vec1 + vec2)),
                ( -1, + (vec1 - vec2)),
                ( -1, - (vec1 - vec2)),
            ]
    else:
        raise ValueError(f"Unsupported key length: {len(key)}")

    arrangement=[
        (c*q, center+v*d/np.linalg.norm(v)) for c,v in arrangement
    ]


    return dict(
        charges=arrangement,
        center=center,
        separation=d,
    )

def get_center_of_charge(mol):
    coords=mol.full_geometry().to_array()
    center=np.sum([ mol.Z(i)/np.sum([mol.Z(i) for i in range(len(coords))]) * c for i,c in enumerate(coords) ] ,axis=0)
    return center
#### END FUNCTIONS

# Description of the method (indicate correction in comments)
method="HF"
basis_set='cc-pvdz'
# IP_TUNING: False
# GRAC correction: False
storage['settings'].update({'method': method, 'grac_correction':False, 'ip_tuning':False})
# Setting the options for the calculation
opts=dict(
    basis           = basis_set      ,
    e_convergence   = 1e-06          , # psi4.default
    d_convergence   = 1e-06          , # psi4.default
    freeze_core     = False          , # Freeze core is significantly cheaper and little impact on e.g. polarizabilities
    scf_type        = 'pk'           ,
    reference       = 'rhf'          ,
)
clean_options() # Set options to default (avoid bad surprises)
set_options(opts)
# Information about the settings printed to output file
print_out(f"INFORMATION about SET METHOD\n")
print_out('\n'.join([f"    {k}={v}\n" for k,v in opts.items()])) 
# Store method options
storage['settings'].update(opts)

# Starting job
def run_job():
    # For HF reference calculation as I understand. Should be probably a bit tighter for finite field (possibly its even faster do to better guess?)
    e_convergence_val=1e-10
    set_options(dict(
        e_convergence=e_convergence_val, 
    ))
    storage['settings']['e_convergence']= e_convergence_val
    # External FIELD PARAMETERS
    center_of_charge = get_center_of_charge(the_molecule) # For evaluation of multipoles and setup of external field
    distance=1000.0 # Large distance to approximate uniform field
    delta_dip=1.000000E-03
    delta_qad=1.000000E-04
    storage['settings']['ff_val_dip']= delta_dip
    storage['settings']['ff_val_qad']= delta_qad
    
    # Field moments to apply finited field
    tensor_elements=[
        'x',
        'y',
        'z',
        'xx',
        'yy',
        'zz',
        'xy',
        'yz',
        'xz',
    ]
    
    psi4.set_global_option('PROPERTIES_ORIGIN', np.array(center_of_charge).tolist() )
    # vec=[ -float(x) for x in center_of_charge ]
    # the_molecule.translate(core.Vector3(vec[0],vec[1],vec[2]))
    
    # Generate external potentials (unit value will be tuned by FF value)
    pot_reg=dict() # Save all external potentials there (base version)
    for tensor_key in tensor_elements:
        pot_base = make_external_field(tensor_key, center_of_charge, d=distance)
        pot_reg.update({ tensor_key:pot_base })
    pot_reg.update( zero=None ) # zero potenial
    
    # Evaluate wfn in external potential
    
    ff_reg=dict()
    E,wfn,grad,mom= get_moments( pot_reg['zero'], 0, do_mom=True ) # Should be True if we want zero point moments
    ff_reg.update( zero=dict({ 'delta':0, 'E':E, 'mom': mom }))
    
    # Save the wave function
    fchk_file='POLARIZ_FF_hf_cc-pvdz_Molecular_Polarizability_2_wid-46636b61-a395-4832-a689-14187bf07d44.fchk'
    fchk(wfn, fchk_file)
    
    storage['files'].update({ 'final_fchk':fchk_file})
    storage['results']['energetic'].update({ 'energy': E, 'gradient': (grad.to_array().tolist() if grad is not None else None) })
    for i,t in enumerate(tensor_elements):
        delta= (delta_dip if len(t)==1 else delta_qad)
        for x in [ -1 , 1 ]: # negative and positive field
            do_mom=True if x>0 else False  # only do moments for positive field (negative is for energy derviation) 
            E,wfn,grad,mom= get_moments( pot_reg[t] , x*delta, 
                do_mom=do_mom ) # only do moments for positive field (negative is for energy derviation) 
            ff_reg.update({ t+('_neg' if x==-1 else '_pos'):dict({ 'delta': x*delta, 'E': E, 'mom': mom } )})
        print_out(f"CUSTOM MARKER BY USER: Finished moment '{t}' ({i} out of {len(tensor_elements)}, {i+1/len(tensor_elements)*100}%)")
    
    # get polarisabilities through finite differences
    pol_reg=dict()
    pol_through_energy=dict()
    for t in tensor_elements:
        first,second, third= ff_reg[t+'_pos'], ff_reg['zero'], ff_reg[t+'_neg']
        print_out(f"E={first['E']} , E0={second['E']} for tag={t} and delta={delta}\n")
        cur_pol=dict()
        delta = (first['delta'] - second['delta'] )
        mapper=dict( (k,i) for i,k in enumerate(['x','y','z']) )
        pol_through_energy[f"{t}@{t}"]=float(-(first['E']-2*second['E']+third['E'])/(delta**2) \ # FD formula (polarisabilities are positive by convention)
            *( 1/2 if len(t)==2 else 1) ) # Induction Energy
        if any(x['mom'] is None for x in [first, second] ): continue
        for k in set(list(first['mom'].keys())+list(second['mom'].keys()) ):
            assert k in first['mom'].keys() and k in second['mom'].keys()
            ff_mom=( first['mom'][k] - second['mom'][k]) / delta
            cur_pol.update({ k:  np.array(ff_mom).tolist() })
        pol_reg.update({ t : cur_pol })
    
    # Gather and reform polarisabilities
    for t in tensor_elements:
        pol = pol_reg[t]
        for k in sorted(pol.keys()):
            m=pol[k]
            np.set_printoptions(precision=3, suppress=True)
            the_string=np.array2string(np.array(m),separator = ' ')
            print_out( f"\n{k}@{t}: pol is \n{the_string}\n" )
    pol_vals=pol_transform(pol_reg)
    # Get Multipoles from zero field calculation
    moms={}
    for k,v in ff_reg['zero']['mom'].items():
        moms.update(tag_matrix(v))
    #Store object
    storage['results']['properties']['expansion_center']= [ float(x) for x in center_of_charge]
    storage['results']['properties']['MolPol_FinFie_through_dens']= pol_vals
    storage['results']['properties']['MolPol_FinFie_through_eng']= pol_through_energy
    storage['results']['properties']['MolMom']= moms

# Execute the job
try:
    start_polariz_ff=time.time()
    run_job()
    storage['about_the_run']['timings']['Total Time for POLARIZ_FF']= start_polariz_ff-time.time()
finally: clean() # I allways want to clean up the scratch

# Dump storage at the end of the run
try:
    dump_storage()
except Exception as ex: raise Exception(f"Could not dump storage: {ex}")
finally: clean()--------------------------------------------------------------------------

